@page
@model ReportsModel
@{
    ViewData["Title"] = "Reports";
}

<div class="text-center align-items-center" style="display: flex; flex-direction: column;">
    <h1 class="display-5">Reports</h1>

    <table class="styled-table">
        <thead>
            <tr>
                <th>Number</th>
                <th>Creation date</th>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @{ 
            var i = 0;
            foreach (var report in Model.reports_list)
                {
                  i += 1;
                  <tr>
                      <td>@i</td>
                      <td>@report.ChangeTime</td>
                      <td>@report.Name</td>
                      <td><a href="/Reports?report_name=@report.Name">Open in new tab</a></td>
                  </tr>
                }
            }
            
        </tbody>
    </table>
</div>

