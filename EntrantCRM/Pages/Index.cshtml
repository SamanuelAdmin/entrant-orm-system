@page
@model IndexModel
@{
    ViewData["Title"] = @Model.title;
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>


<div class="text-center align-items-center" style="display: flex; flex-direction: column;">
    <h1 class="display-5">Reports</h1>

    <table class="styled-table">
        <thead>
            <tr>
                <th>Number</th>
                @foreach (System.Data.DataColumn column in Model.Columns)
                {
                    <th>@column.ColumnName</th>
                }
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{ 
                var i = 1;
                @foreach (System.Data.DataRow row in Model.table.Rows)
                {
                    <tr>
                        @foreach (System.Data.DataColumn column in Model.table.Columns)
                        {
                            <td>@row[column]</td>
                            <td>
                                <form method="post">
                                    <input name="action" value="remove">
                                    <input name="viewname" value="@Model.viewname">
                                    <input name="rowname" value="@row["name"]">
                                    <button type="submit">Remove</button>
                                </form>
                            </td>
                        }
                    </tr>
                    i += 1;
                }
                
            }


            <tr>
                <th></th>
                <form method="post">
                    @foreach (System.Data.DataColumn column in Model.Columns)
                    {
                        <th>
                            <input name="@column.ColumnName" type=text>
                        </th>
                    }
                    <th>
                        <button type="submit">Add new</button>
                    </th>
                </form>
            </td>
        </tbody>
    </table>
</div>
