@page
@model IndexModel
@{
    ViewData["Title"] = @Model.title;
}



<div class="text-center align-items-center" style="display: flex; flex-direction: column;">
    <h1 class="display-5">@Model.title</h1>

    <table class="styled-table">
        <thead>
            <tr>
                <th class="text-center">Number</th>
                @foreach (System.Data.DataColumn column in Model.table.Columns)
                {
                    <th>@column.ColumnName</th>
                }
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{ 
                var i = 1;

                @foreach (System.Data.DataRow row in Model.table.Rows)
                {
                    <tr>
                        <td>@i</td>
                        @foreach (System.Data.DataColumn column in Model.table.Columns)
                        {
                            <td>@row[column]</td>
                        }

                        <td>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="viewname" value="@Model.viewname">
                                <input type="hidden" name="rowid" value="@row["PK"]">
                                <button type="submit">Remove</button>
                            </form>
                        </td>
                    </tr>
                    i += 1;
                }
                
            }


            <tr>
                <th></th>
                <form method="post">
                    <input type="hidden" name="viewname" value="@Model.viewname">
                    @foreach (System.Data.DataColumn column in Model.table.Columns)
                    {
                        <th>
                            @if (column.ColumnName != "PK") {
                                    <input name="@column.ColumnName" type=text>
                            }
                        </th>
                    }
                    <th>
                        <button type="submit">+</button>
                    </th>
                </form>
            </td>
        </tbody>
    </table>

    <a asp-page="/Index" asp-page-handler="Report" asp-route-viewname="@Model.viewname">Generate report</a>
</div>
