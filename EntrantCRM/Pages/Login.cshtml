@page
@model IndexModel
@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <form id="registrationForm" action="" method="POST">
                            <div class="form-group">
                                <label for="login">
                                    Login
                                </label>
                                <input type="login" 
                                       class="form-control" 
                                       id="login" 
                                       placeholder="login" required />
                            </div>
                            <div class="form-group">
                                <label for="password">
                                    Password
                                </label>
                                <input type="password" 
                                       class="form-control" 
                                       id="password" 
                                       placeholder="Password"
                                    required />
                            </div>
                            <div class="form-group">
                                <label for="link">
                                    Link
                                </label>
                                <input type="link" 
                                       class="form-control" 
                                       id="link" 
                                       placeholder="link"
                                    required />
                            </div>
                            <button class="btn btn-danger">
                                Login
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
